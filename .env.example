# Copy to .env and fill in. Never commit .env.

# --- Server ---
PORT=3001
# Keep this on loopback: the server controls your browser during booking assist.
HOST=127.0.0.1
# Results in this currency sort first; other currencies sort after it.
PREFERRED_CURRENCY=INR
# Minimum gap between requests to the same API host (ms). Keep it low-rate.
HTTP_MIN_INTERVAL_MS=500
# SQLite file (watchlist, price history, alerts, sessions). Default: ./data/ticket-assistant.db
# DB_FILE=
# Extra browser origins allowed to use the API (comma-separated). Rarely needed.
# ALLOWED_ORIGINS=

# --- District (district.in): no API key. Site search runs in your Chrome; pages are fetched by the server ---
DISTRICT_ENABLED=true
# Gap between District page requests (ms, minimum 1000) and pages per search.
DISTRICT_MIN_INTERVAL_MS=1500
DISTRICT_MAX_PAGES=5

# --- BookMyShow: read in your Chrome (needs CDP_URL below), no API key ---
BOOKMYSHOW_ENABLED=true
BOOKMYSHOW_MAX_PAGES=4

# --- Ticketmaster Discovery API (https://developer.ticketmaster.com/) ---
# Use the app's "Consumer Key". Ticketmaster has little Indian inventory.
TICKETMASTER_API_KEY=
# Optional ISO country filter, e.g. IN, GB, US. Leave empty for all markets.
TICKETMASTER_COUNTRY_CODE=

# --- Local demo site (npm run demo-site) for trying booking assist safely ---
DEMO_SITE_URL=http://127.0.0.1:4100

# --- Your Chrome with remote debugging (see README): BookMyShow, District search, booking assist ---
CDP_URL=http://localhost:9222
# Gap between requests to one site from your Chrome (ms, minimum 1000).
BROWSER_MIN_INTERVAL_MS=1500

# --- On-sale watcher ---
WATCHER_ENABLED=true
# Minutes between checks of watched events (minimum 5).
WATCH_INTERVAL_MIN=15

# --- Optional alert channels (in-app alerts always work) ---
# Email via SMTP, e.g. smtps://user:app-password@smtp.gmail.com:465
SMTP_URL=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
# SMS via Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
ALERT_SMS_TO=
