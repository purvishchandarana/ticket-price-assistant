# Copy to .env and fill in. Never commit .env.

# --- Server ---
PORT=3001
# Keep this on loopback: the server will (from step 3) control your browser.
HOST=127.0.0.1
# Results in this currency sort first; other currencies sort after it.
PREFERRED_CURRENCY=INR
# Minimum gap between requests to the same API host (ms). Keep it low-rate.
HTTP_MIN_INTERVAL_MS=500

# --- Ticketmaster Discovery API (https://developer.ticketmaster.com/) ---
TICKETMASTER_API_KEY=
# Optional ISO country filter. Ticketmaster's coverage of India is limited;
# leave empty to search all markets.
TICKETMASTER_COUNTRY_CODE=IN

# --- SeatGeek Platform API (later) ---
SEATGEEK_CLIENT_ID=
SEATGEEK_CLIENT_SECRET=

# --- Eventbrite API (later) ---
EVENTBRITE_TOKEN=

# --- Browser automation (step 3) ---
CDP_URL=http://localhost:9222

# --- Alerts (step 5, optional) ---
SMTP_URL=
ALERT_EMAIL_TO=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
ALERT_SMS_TO=
